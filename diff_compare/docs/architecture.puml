@startuml
skinparam backgroundColor #ffffff
skinparam componentStyle rectangle
skinparam arrowColor #444444
skinparam component {
  BackgroundColor<<core>> #f0f6ff
  BackgroundColor<<io>> #fff6ec
  BackgroundColor<<app>> #f6f6f6
}

rectangle "CLI / 列差异工具" <<app>> as cli
component "ColumnProcessingPipeline\n（列处理管线）" <<app>> as pipeline
component "SeriesComparatorFactory\n（比较器工厂）" <<core>> as factory
component "SeriesData\n（序列数据）" <<core>> as seriesData
component "SeriesComparator\n（数值/文本·可并行）" <<core>> as comparators
component "SeriesDiff\n（差异结果）" <<core>> as seriesDiff
component "TxtColumnInputProvider\n（mmap + int64 缓存）" <<io>> as input
component "ColumnParser\n（列解析器）" <<io>> as parser
component "TxtDiffOutputWriter\n（文本输出）" <<io>> as writer
component "PlainTextOutputFormatter\n（纯文本格式化）" <<io>> as formatter

cli --> pipeline
pipeline --> input : 读取列文件
input --> parser : 清理/校验表头
input --> seriesData : 构建 SeriesData
pipeline --> factory : 选择比较器
factory --> comparators
comparators --> seriesDiff
seriesDiff --> formatter
formatter --> writer
writer --> pipeline : 写入结果

note right of seriesData
  懒加载 string_view 指向 mmap 内存，
  整型列同时缓存 int64 数据以避免重复解析。
end note

note bottom of comparators
  数值比较器优先使用整型缓存，
  缺失时回退到 string_view 解析。
end note

legend right
  |= 层级 =| 组件 |
  | 应用层 | CLI、ColumnProcessingPipeline |
  | I/O 层 | TxtColumnInputProvider、Parser、Formatter |
  | 核心层 | SeriesData、Comparators、SeriesDiff |
endlegend

@enduml
