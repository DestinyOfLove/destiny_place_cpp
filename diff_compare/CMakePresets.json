{
    "version": 8,
    "configurePresets": [
        {
            "name": "diff_compare",
            "displayName": "Configure preset using toolchain file",
            "description": "Sets Ninja generator, build and install directory",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "DIFF_COMPARE_ENABLE_TESTS": "ON",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "diff_compare_perf_release",
            "displayName": "Release configure for performance benchmarks",
            "description": "Configures Release build with perf benchmarks enabled",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/perf_release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "DIFF_COMPARE_ENABLE_TESTS": "OFF",
                "BUILD_TESTING": "OFF",
                "DIFF_COMPARE_ENABLE_PERF": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "diff_compare",
            "configurePreset": "diff_compare"
        },
        {
            "name": "diff_compare_perf_release",
            "configurePreset": "diff_compare_perf_release",
            "targets": [
                "diff_compare_perf"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "diff_compare",
            "displayName": "Run diff_compare tests",
            "configurePreset": "diff_compare",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
